# Cloudflare Pages response headers.
# Format: a path pattern, then indented header lines.

# Images and fonts are content-addressed in practice — a changed image gets a
# new filename — so they can be cached hard and never revalidated.
/imgs-craft/*
  Cache-Control: public, max-age=31536000, immutable
/imgs-digital/*
  Cache-Control: public, max-age=31536000, immutable
/imgs-expo/*
  Cache-Control: public, max-age=31536000, immutable
/imgs-archival/*
  Cache-Control: public, max-age=31536000, immutable
/imgs-lab/*
  Cache-Control: public, max-age=31536000, immutable

# Shared CSS/JS and the 3D scene assets. These DO change under a stable name,
# so they are cached for a day and revalidated rather than frozen for a year.
/assets/*
  Cache-Control: public, max-age=86400, must-revalidate

# HTML must always be revalidated, or a deploy won't reach people who have
# already visited.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Site-wide security headers. No page here embeds others or needs to be embedded.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
